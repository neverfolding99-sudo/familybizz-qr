# Kopiér til .env og ret din adgangskode (bruges ved lokal test).
#
# På cPanel: sæt ADMIN_PASSWORD som miljøvariabel i Node.js-app'ens
# indstillinger i stedet — så ligger den slet ikke i en fil.
ADMIN_PASSWORD=skift-mig

# PORT bruges kun ved lokal test. På cPanel/Passenger styres forbindelsen
# automatisk, og server.js behøver ingen ændring.
# PORT=3000